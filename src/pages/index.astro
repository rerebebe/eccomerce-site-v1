<script>
const intro = document.querySelector("[data-intro]");
const skip = new URLSearchParams(location.search).get("intro") === "off";
if (!intro || skip) {
  if (intro) intro.remove();
  window.OFO && window.OFO.release();
} else {
  document.body.style.overflow = "hidden";
  window.scrollTo(0, 0);
  setTimeout(() => window.OFO && window.OFO.release(), 4500);
  setTimeout(() => { document.body.style.overflow = ""; intro.remove(); }, 5500);
}
const strip = document.querySelector("[data-works-scroll]");
if (strip) {
  const pos = document.querySelector("[data-work-pos]");
  const bar = document.querySelector("[data-work-bar]");
  const n = strip.querySelectorAll("a").length;
  const pad = (x) => String(x).padStart(2, "0");
  strip.addEventListener("scroll", () => {
    const max = strip.scrollWidth - strip.clientWidth;
    const i = max > 0 ? Math.round((strip.scrollLeft / max) * (n - 1)) : 0;
    pos.textContent = pad(i + 1) + " / " + pad(n);
    bar.style.transform = "translateX(" + i * 100 + "%)";
  }, { passive: true });
}
</script>

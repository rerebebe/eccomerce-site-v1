---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const WORKS = [
  { sn: "N°001", en: "Unisex Double-Breasted, Navy Flannel", zh: "男女款雙排扣", img: "/images/1594938298603-c8148c4dae35-800x1000-bw.jpg" },
  { sn: "N°002", en: "Collarless Tie-Front Blazer", zh: "無領綁帶西裝外套", img: "/images/1593032465175-481ac7f401a0-800x1000-bw.jpg" },
  { sn: "N°003", en: "Tailored Waistcoat", zh: "訂製背心", img: "/images/1618886614638-80e3c103d31a-800x1000-bw.jpg" },
  { sn: "N°006", en: "Tailored Backless Dress", zh: "修身露背連身裙", img: "/images/1600091166971-7f9faad6c1e2-800x1000-bw.jpg" }
];
const works = WORKS;
---
<Base title="ONE OF ONE 獨壹 — Be Rare">
<div data-hold="1" style="background:var(--bg);color:var(--ink);font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;overflow-x:clip">

  <div data-intro>
    <div style="position:fixed;inset:0;z-index:200;background:var(--bg);display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;animation:ofoCurtain 1.1s cubic-bezier(0.76,0,0.24,1) 4.3s both">
      <div style="animation:ofoIntroOut 0.6s ease 4s both;display:flex;flex-direction:column;align-items:center;gap:clamp(22px,3vw,38px)">
        <div role="img" aria-label="ONE OF ONE" style="position:relative;width:min(82vw,680px);aspect-ratio:1041/455">
          <div style="position:absolute;inset:0;background:var(--ink);-webkit-mask:url(/assets/oneofone-logo.png) center/100% 100% no-repeat;mask:url(/assets/oneofone-logo.png) center/100% 100% no-repeat;animation:ofoArcWipe 1.8s cubic-bezier(0.65,0,0.35,1) 0.25s both"></div>
          <div style="position:absolute;inset:0;-webkit-mask:linear-gradient(90deg,#242321 40%,transparent 60%) 100% 0/300% 100% no-repeat;mask:linear-gradient(90deg,#242321 40%,transparent 60%) 100% 0/300% 100% no-repeat;animation:ofoSweep 1.8s cubic-bezier(0.4,0,0.2,1) 1.5s both">
            <div style="position:absolute;inset:0;background:var(--ink);clip-path:inset(62% 0 0 0);-webkit-mask:url(/assets/oneofone-logo.png) center/100% 100% no-repeat;mask:url(/assets/oneofone-logo.png) center/100% 100% no-repeat"></div>
          </div>
        </div>
        <div style="display:flex;gap:clamp(12px,2vw,26px);font-family:'IBM Plex Mono',monospace;font-size:clamp(12px,1.25vw,16px);letter-spacing:0.28em;color:var(--mute);animation:ofoCapt 1s ease 2.9s both">
          <span>獨壹</span>
          <span style="color:var(--accent)">BE RARE</span>
          <span>TAIPEI</span>
        </div>
      </div>
    </div>
  </div>

  <Header current="index" />

  <section data-screen-label="01 Hero" style="position:relative;height:100svh;min-height:560px;max-height:1040px;overflow:hidden;color:#F9EFE6;background:#242321">
    <div data-reveal="1" style="position:absolute;inset:0;overflow:hidden;clip-path:inset(100% 0 0 0);transition:clip-path 1.6s cubic-bezier(0.77,0,0.18,1)">
      <div data-parallax="-0.18" style="position:absolute;top:-12%;bottom:-12%;left:0;right:0">
        <img src="/images/1617137984095-74e4e5e3613f-2200x1400-bw.jpg" alt="" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.22);transition:transform 2.6s cubic-bezier(0.2,0.7,0.2,1)" />
      <div style="position: absolute; inset: 0; background: linear-gradient(180deg,rgba(36,35,33,0.5) 0%,rgba(36,35,33,0.08) 38%,rgba(36,35,33,0.82) 100%); left: -1px; top: 75px"><div style="position: absolute; top: calc(44px + clamp(20px,4vw,56px)); left: clamp(16px,3vw,40px); display: flex; justify-content: space-between; gap: 24px; font-family: 'IBM Plex Mono',monospace; font-size: 11px; letter-spacing: 0.2em; color: #ECE2D9; right: clamp(16px,3vw,40px)">
      <span>TAIPEI · 台北</span>
      <div class="ofo-d">
<span style="text-align:right">BESPOKE &amp; MADE-TO-MEASURE<br />訂製西服 · 不分性別</span>
</div>
<div class="ofo-m">
<span style="text-align:right">訂製西服<br />UNISEX</span>
</div>
    </div></div></div></div>

    <div style="position:absolute;left:0;right:0;bottom:0;padding:0 clamp(16px,3vw,40px) clamp(28px,4vw,56px)">
      <!-- <h1 data-rise="1" style="margin: 0; font-family: 'Bodoni Moda',serif; font-weight: 400; line-height: 0; opacity: 0; transform: translateY(40px); transition: opacity 1.2s ease 0.5s,transform 1.4s cubic-bezier(0.2,0.7,0.2,1) 0.5s; z-index: -2"><img src="/assets/logo-stacked-white.png" alt="ONE OF ONE" style="display: block; height: 407px; width: 477px; max-width: 100%; object-fit: contain; object-position: left bottom; z-index: -2; margin-left: clamp(0px, 3.5vw, 50px)" /></h1> -->
      <img src="/assets/logo-stacked-white.png" alt="ONE OF ONE" style="display: block; width: 40%; height: auto; max-width: 420px; min-width: 140px; margin-left: clamp(0px, 3.5vw, 50px)" />

      <div data-rise="1" style="margin-top:clamp(18px,3vw,34px);display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:24px;border-top:1px solid rgba(249,239,230,0.28);padding-top:18px;opacity:0;transform:translateY(24px);transition:opacity 1s ease 0.9s,transform 1.2s cubic-bezier(0.2,0.7,0.2,1) 0.9s">
        <p style="margin:0;max-width:46ch;font-size:clamp(14px,1.15vw,17px);line-height:1.65;color:#ECE2D9;text-wrap:pretty">高級剪裁與低調奢華為核心。每一件都為一個人而生，不再重複。<br />Every garment is cut for one body, and made once.</p>
        <div class="ofo-d">
<a class="hv-idx-1" href="/registry/" style="display:inline-flex;align-items:center;gap:12px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;padding-bottom:6px;border-bottom:1px solid #F9EFE6;color:#F9EFE6;transition:gap 0.3s ease">BE RARE. →</a>
</div>
<div class="ofo-m">
<a href="/registry/" style="flex:1 1 100%;height:52px;display:flex;align-items:center;justify-content:space-between;padding:0 18px;border:1px solid rgba(249,239,230,0.6);color:#F9EFE6;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em">探索作品 BE RARE<span>→</span></a>
</div>
      </div>
      <div class="ofo-m">
<div style="height:72px"></div>
</div>
    </div>
  </section>

  <div style="display:flex;overflow:hidden;border-bottom:1px solid var(--line);background:var(--bg2)">
    <div style="display:flex;flex:none;animation:ofoMarquee 34s linear infinite;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.28em;color:var(--mute);padding:15px 0">
      <span style="flex:none;padding-right:28px">BE RARE · 獨壹 · ONE OF ONE · 不分性別的訂製 · UNISEX TAILORING · BE RARE · 獨壹 · ONE OF ONE · 不分性別的訂製 · UNISEX TAILORING ·&nbsp;</span>
      <span style="flex:none;padding-right:28px">BE RARE · 獨壹 · ONE OF ONE · 不分性別的訂製 · UNISEX TAILORING · BE RARE · 獨壹 · ONE OF ONE · 不分性別的訂製 · UNISEX TAILORING ·&nbsp;</span>
    </div>
  </div>

  <section data-screen-label="02 Statement" style="padding: clamp(80px,12vw,200px) clamp(16px,3vw,40px); background-color: #F9EFE6">
    <div style="max-width:1120px;margin:0 auto;display:grid;gap:clamp(22px,3vw,40px)">
      <div data-rise="1" style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;color:var(--accent);opacity:0;transform:translateY(28px);transition:opacity 1s ease,transform 1.2s cubic-bezier(0.2,0.7,0.2,1)">BE RARE — 獨壹</div>
      <p data-rise="1" style="margin:0;font-family:'Bodoni Moda',serif;font-size:clamp(28px,4.2vw,62px);line-height:1.12;text-wrap:balance;opacity:0;transform:translateY(28px);transition:opacity 1s ease 0.1s,transform 1.2s cubic-bezier(0.2,0.7,0.2,1) 0.1s">Tailoring without a size chart. Every garment is drafted for one body, cut from one length of cloth — and never made again.</p>
      <p data-rise="1" style="margin:0;font-size:clamp(15px,1.15vw,17px);line-height:1.75;color:var(--mute);max-width:52ch;text-wrap:pretty;opacity:0;transform:translateY(28px);transition:opacity 1s ease 0.2s,transform 1.2s cubic-bezier(0.2,0.7,0.2,1) 0.2s">從細緻的布料選擇到講究的版型設計，每一處細節皆經過精心雕琢。我們不做尺碼，只做那一個人的身形。</p>
    </div>
  </section>

  <div class="ofo-d">
<section data-screen-label="03 Selected works" style="padding:0 clamp(16px,3vw,40px) clamp(80px,10vw,160px);background:var(--bg)">
    <div style="max-width:1320px;margin:0 auto">
      <div style="display:flex;align-items:baseline;gap:16px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;color:var(--mute);padding-bottom:clamp(28px,4vw,56px)">
        <span style="color:var(--accent)">SELECTED WORKS</span>
        <span>作品選輯</span>
        <span style="flex:1;height:1px;background:var(--line)"></span>
        <span>N°001 — N°007</span>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:clamp(24px,5vw,90px);align-items:flex-start">
        <a href="/registry/" style="flex:1 1 520px;display:grid;gap:16px">
          <div data-reveal="1" style="position:relative;overflow:hidden;aspect-ratio:4/5;background:var(--bg2);clip-path:inset(100% 0 0 0);transition:clip-path 1.4s cubic-bezier(0.77,0,0.18,1)">
            <div data-parallax="-0.06" style="position:absolute;top:-8%;bottom:-8%;left:0;right:0">
              <img src="/images/1594938298603-c8148c4dae35-1200x1500-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.18);transition:transform 1.9s cubic-bezier(0.2,0.7,0.2,1)" />
            </div>
          </div>
          <div data-rise="1" style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 20px;opacity:0;transform:translateY(20px);transition:opacity 0.9s ease 0.3s,transform 1.1s cubic-bezier(0.2,0.7,0.2,1) 0.3s">
            <span style="font-family:'Bodoni Moda',serif;font-size:clamp(18px,1.5vw,22px)">Unisex Double-Breasted, Navy Flannel</span>
            <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute)">N°001 · 男女款雙排扣</span>
          </div>
        </a>
        <a href="/registry/" style="flex:1 1 280px;max-width:460px;margin-top:clamp(0px,14vw,240px);display:grid;gap:16px">
          <div data-reveal="1" style="position:relative;overflow:hidden;aspect-ratio:3/4;background:var(--bg2);clip-path:inset(100% 0 0 0);transition:clip-path 1.4s cubic-bezier(0.77,0,0.18,1) 0.15s">
            <div data-parallax="-0.1" style="position:absolute;top:-10%;bottom:-10%;left:0;right:0">
              <img src="/images/1593032465175-481ac7f401a0-900x1200-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.18);transition:transform 1.9s cubic-bezier(0.2,0.7,0.2,1) 0.15s" />
            </div>
          </div>
          <div data-rise="1" style="display:grid;gap:6px;opacity:0;transform:translateY(20px);transition:opacity 0.9s ease 0.4s,transform 1.1s cubic-bezier(0.2,0.7,0.2,1) 0.4s">
            <span style="font-family:'Bodoni Moda',serif;font-size:clamp(18px,1.5vw,22px)">Collarless Tie-Front Blazer</span>
            <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute)">N°002 · 無領綁帶西裝外套</span>
          </div>
        </a>
      </div>
    </div>
  </section>
</div>
<div class="ofo-m">
  <section data-screen-label="03 Selected works (mobile)" style="padding:0 0 72px;background:var(--bg)">
    <div style="display:flex;align-items:baseline;gap:12px;padding:0 16px 18px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute)">
      <span style="color:var(--accent)">SELECTED WORKS</span>
      <span style="flex:1;height:1px;background:var(--line)"></span>
      <span data-work-pos>01 / 04</span>
    </div>
    <div data-works-scroll style="display:flex;gap:12px;overflow-x:auto;scroll-snap-type:x mandatory;padding:0 16px;scroll-padding:0 16px;scrollbar-width:none;-webkit-overflow-scrolling:touch">
      {works.map((w) => (<Fragment>
        <a href="/registry/" style="flex:0 0 80%;scroll-snap-align:start;display:grid;gap:12px">
          <div style="aspect-ratio:4/5;overflow:hidden;background:var(--bg2)">
            <img src={w.img} alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover" />
          </div>
          <div style="display:grid;gap:4px">
            <span style="font-family:'Bodoni Moda',serif;font-size:19px;line-height:1.25">{w.en}</span>
            <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute)">{w.sn} · {w.zh}</span>
          </div>
        </a>
      </Fragment>))}
      <div style="flex:0 0 4px"></div>
    </div>
    <div style="position:relative;margin:22px 16px 0;height:1px;background:var(--line)">
      <div data-work-bar style="position:absolute;left:0;top:-1px;height:3px;width:25%;background:var(--ink);transform:translateX(0%);transition:transform 0.35s cubic-bezier(0.2,0.7,0.2,1)"></div>
    </div>
  </section>
</div>

  <section data-screen-label="04 Cloth" style="position:relative;height:clamp(460px,72vw,900px);overflow:hidden;color:#F9EFE6;background:#242321">
    <div data-reveal="1" style="position:absolute;inset:0;overflow:hidden;clip-path:inset(100% 0 0 0);transition:clip-path 1.6s cubic-bezier(0.77,0,0.18,1)">
      <div data-parallax="-0.14" style="position:absolute;top:-14%;bottom:-14%;left:0;right:0">
        <img src="/images/1497997092403-f091fcf5b6c4-2200x1400-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.15);transition:transform 2.4s cubic-bezier(0.2,0.7,0.2,1)" />
      </div>
    </div>
    <div style="position:absolute;inset:0;background:linear-gradient(90deg,rgba(36,35,33,0.72) 0%,rgba(36,35,33,0.2) 60%,rgba(36,35,33,0) 100%)"></div>
    <div style="position:absolute;left:clamp(16px,3vw,40px);right:clamp(16px,3vw,40px);bottom:clamp(32px,5vw,80px);display:grid;gap:22px;max-width:640px">
      <div data-rise="1" style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;color:#ECE2D9;opacity:0;transform:translateY(24px);transition:opacity 1s ease 0.4s,transform 1.2s cubic-bezier(0.2,0.7,0.2,1) 0.4s">ⅱ — CLOTH 布料</div>
      <h2 data-rise="1" style="margin:0;font-family:'Bodoni Moda',serif;font-weight:400;font-size:clamp(34px,5.4vw,84px);line-height:1;text-wrap:balance;opacity:0;transform:translateY(24px);transition:opacity 1s ease 0.5s,transform 1.2s cubic-bezier(0.2,0.7,0.2,1) 0.5s">It all starts with the cloth.</h2>
      <a data-rise="1" href="/atelier/" style="justify-self:start;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;border-bottom:1px solid #F9EFE6;padding-bottom:6px;color:#F9EFE6;opacity:0;transform:translateY(24px);transition:opacity 1s ease 0.6s,transform 1.2s cubic-bezier(0.2,0.7,0.2,1) 0.6s">THE ATELIER →</a>
    </div>
  </section>

  <div class="ofo-d">
<section data-screen-label="05 Selected works II" style="padding: clamp(80px,10vw,160px) clamp(16px,3vw,40px); background-color: #F9EFE6">
    <div style="max-width:1320px;margin:0 auto;display:grid;gap:clamp(60px,9vw,150px)">
      <div style="display:flex;flex-wrap:wrap-reverse;gap:clamp(24px,5vw,90px);align-items:flex-end">
        <a href="/registry/" style="flex:1 1 280px;max-width:440px;margin-bottom:clamp(0px,10vw,180px);display:grid;gap:16px">
          <div data-reveal="1" style="position:relative;overflow:hidden;aspect-ratio:3/4;background:var(--bg2);clip-path:inset(100% 0 0 0);transition:clip-path 1.4s cubic-bezier(0.77,0,0.18,1)">
            <div data-parallax="-0.1" style="position:absolute;top:-10%;bottom:-10%;left:0;right:0">
              <img src="/images/1618886614638-80e3c103d31a-900x1200-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.18);transition:transform 1.9s cubic-bezier(0.2,0.7,0.2,1)" />
            </div>
          </div>
          <div data-rise="1" style="display:grid;gap:6px;opacity:0;transform:translateY(20px);transition:opacity 0.9s ease 0.3s,transform 1.1s cubic-bezier(0.2,0.7,0.2,1) 0.3s">
            <span style="font-family:'Bodoni Moda',serif;font-size:clamp(18px,1.5vw,22px)">Tailored Waistcoat</span>
            <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute)">N°003 · 訂製背心</span>
          </div>
        </a>
        <a href="/registry/" style="flex:1 1 520px;display:grid;gap:16px">
          <div data-reveal="1" style="position:relative;overflow:hidden;aspect-ratio:5/6;background:var(--bg2);clip-path:inset(100% 0 0 0);transition:clip-path 1.4s cubic-bezier(0.77,0,0.18,1) 0.15s">
            <div data-parallax="-0.06" style="position:absolute;top:-8%;bottom:-8%;left:0;right:0">
              <img src="/images/1600091166971-7f9faad6c1e2-1200x1440-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.18);transition:transform 1.9s cubic-bezier(0.2,0.7,0.2,1) 0.15s" />
            </div>
          </div>
          <div data-rise="1" style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:8px 20px;opacity:0;transform:translateY(20px);transition:opacity 0.9s ease 0.4s,transform 1.1s cubic-bezier(0.2,0.7,0.2,1) 0.4s">
            <span style="font-family:'Bodoni Moda',serif;font-size:clamp(18px,1.5vw,22px)">Tailored Backless Dress</span>
            <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute)">N°006 · 修身露背連身裙</span>
          </div>
        </a>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:clamp(16px,3vw,48px);align-items:start">
        <div data-reveal="1" style="position:relative;overflow:hidden;aspect-ratio:3/4;background:var(--bg2);clip-path:inset(100% 0 0 0);transition:clip-path 1.3s cubic-bezier(0.77,0,0.18,1)">
          <img src="/images/1594938328870-9623159c8c99-800x1070-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.18);transition:transform 1.8s cubic-bezier(0.2,0.7,0.2,1)" />
        </div>
        <div data-reveal="1" style="position:relative;overflow:hidden;aspect-ratio:3/4;background:var(--bg2);margin-top:clamp(0px,6vw,110px);clip-path:inset(100% 0 0 0);transition:clip-path 1.3s cubic-bezier(0.77,0,0.18,1) 0.15s">
          <img src="/images/1631052066165-9720608b36da-800x1070-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.18);transition:transform 1.8s cubic-bezier(0.2,0.7,0.2,1) 0.15s" />
        </div>
        <div data-reveal="1" style="position:relative;overflow:hidden;aspect-ratio:3/4;background:var(--bg2);clip-path:inset(100% 0 0 0);transition:clip-path 1.3s cubic-bezier(0.77,0,0.18,1) 0.3s">
          <img src="/images/1679101893304-045625840a94-800x1070-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.18);transition:transform 1.8s cubic-bezier(0.2,0.7,0.2,1) 0.3s" />
        </div>
      </div>
    </div>
  </section>
</div>

  <section data-screen-label="06 The house" style="color: var(--inkA); padding: clamp(70px,10vw,160px) clamp(16px,3vw,40px); background-color: #242321">
    <div style="max-width:1320px;margin:0 auto">
      <div style="display:flex;align-items:baseline;gap:16px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;color:var(--muteA);padding-bottom:clamp(24px,4vw,48px)">
        <span style="color:var(--accentA)">THE HOUSE</span>
        <span>探索</span>

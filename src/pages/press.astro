---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

---
<Base title="Press — ONE OF ONE 獨壹">
<div style="background:var(--bg);color:var(--ink);font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;overflow-x:clip">
  <Header current="press" />

  <section data-screen-label="01 Title" style="padding:calc(64px + clamp(56px,9vw,140px)) clamp(16px,3vw,40px) clamp(40px,6vw,90px)">
    <div style="max-width:1320px;margin:0 auto">
      <div style="display:flex;align-items:baseline;gap:16px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;color:var(--mute);padding-bottom:clamp(24px,4vw,48px)">
        <span style="color:var(--accent)">05</span>
        <span>PRESS &amp; FILM — 媒體與影像</span>
        <span style="flex:1;height:1px;background:var(--line)"></span>
      </div>
      <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:28px">
        <h1 data-rise="1" style="margin:0;font-family:'Bodoni Moda',serif;font-weight:400;font-size:clamp(60px,12vw,190px);line-height:0.88;letter-spacing:-0.015em;opacity:0;transform:translateY(40px);transition:opacity 1.1s ease,transform 1.3s cubic-bezier(0.2,0.7,0.2,1)">Press</h1>
        <p data-rise="1" style="margin:0;max-width:40ch;font-size:clamp(15px,1.15vw,17px);line-height:1.75;color:var(--mute);text-wrap:pretty;opacity:0;transform:translateY(24px);transition:opacity 1s ease 0.2s,transform 1.2s cubic-bezier(0.2,0.7,0.2,1) 0.2s">報導、形象影片與工作室日常。</p>
      </div>
    </div>
  </section>

  <section data-screen-label="02 Film" style="padding:0 clamp(16px,3vw,40px)">
    <a href="https://youtu.be/eNoB57ggJCM" target="_blank" rel="noopener" style="display:block;max-width:1320px;margin:0 auto;color:#F9EFE6">
      <div data-reveal="1" style="position:relative;aspect-ratio:var(--ar-film);overflow:hidden;background:#242321;clip-path:inset(100% 0 0 0);transition:clip-path 1.6s cubic-bezier(0.77,0,0.18,1) 0.2s">
        <div data-parallax="-0.1" style="position:absolute;top:-10%;bottom:-10%;left:0;right:0">
          <img src="/images/1617137984095-74e4e5e3613f-2200x1200-bw.jpg" alt="" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.18);transition:transform 2.2s cubic-bezier(0.2,0.7,0.2,1) 0.2s" />
        </div>
        <div style="position:absolute;inset:0;background:rgba(36,35,33,0.38)"></div>
        <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:18px">
          <span class="hv-press-1" style="width:clamp(64px,7vw,96px);aspect-ratio:1;border:1px solid rgba(249,239,230,0.7);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:clamp(16px,1.6vw,22px);padding-left:4px;transition:background 0.3s ease">▶</span>
          <span style="font-family:'Bodoni Moda',serif;font-size:clamp(26px,3.4vw,52px)">Brand Film</span>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;color:#ECE2D9">WATCH — 形象影片</span>
        </div>
      </div>
    </a>
  </section>

  <section data-screen-label="03 Coverage" style="padding:clamp(70px,10vw,160px) clamp(16px,3vw,40px)">
    <div style="max-width:1320px;margin:0 auto">
      <div style="display:flex;align-items:baseline;gap:16px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;color:var(--mute);padding-bottom:clamp(20px,3vw,36px)">
        <span style="color:var(--accent)">COVERAGE</span>
        <span>媒體報導</span>
        <span style="flex:1;height:1px;background:var(--line)"></span>
      </div>
      <a href="https://www.stylemaster.com.tw/2025/12/18/71499/" target="_blank" rel="noopener" data-rise="1" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:clamp(18px,3vw,48px);align-items:center;padding:clamp(22px,3vw,40px) 0;border-bottom:1px solid var(--line);opacity:0;transform:translateY(24px);transition:opacity 1s ease,transform 1.2s cubic-bezier(0.2,0.7,0.2,1)">
        <div style="position:relative;aspect-ratio:3/2;overflow:hidden;background:var(--bg2)">
          <img class="hv-press-2" src="/images/1594938298603-c8148c4dae35-900x600-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transition:transform 0.8s ease" />
        </div>
        <div style="display:grid;gap:14px">
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--accent)">STYLEMASTER · 2025.12.18</span>
          <span style="font-family:'Bodoni Moda',serif;font-size:clamp(24px,2.6vw,40px);line-height:1.15;text-wrap:balance">專訪：一人一版，台北訂製新生代</span>
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;color:var(--mute)">READ ARTICLE →</span>
        </div>
      </a>
      <div data-rise="1" style="display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;padding:clamp(22px,3vw,34px) 0;border-bottom:1px solid var(--line);opacity:0;transform:translateY(24px);transition:opacity 1s ease 0.1s,transform 1.2s cubic-bezier(0.2,0.7,0.2,1) 0.1s">
        <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute)">MEDIA ENQUIRIES — 媒體聯繫</span>
        <a href="mailto:hello@oneofoneunite.com" style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;border-bottom:1px solid var(--line)">HELLO@ONEOFONEUNITE.COM</a>
      </div>
    </div>
  </section>

  <section data-screen-label="04 Instagram" style="background:var(--bgA);color:var(--inkA);padding:clamp(70px,10vw,160px) clamp(16px,3vw,40px)">
    <div style="max-width:1320px;margin:0 auto">
      <div style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:20px;padding-bottom:clamp(28px,4vw,56px)">
        <h2 data-rise="1" style="margin:0;font-family:'Bodoni Moda',serif;font-weight:400;font-size:clamp(32px,5vw,76px);line-height:1;opacity:0;transform:translateY(28px);transition:opacity 1s ease,transform 1.2s cubic-bezier(0.2,0.7,0.2,1)">@oneofone.unite</h2>
        <a href="https://www.instagram.com/oneofone.unite" target="_blank" rel="noopener" style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;color:var(--inkA);border-bottom:1px solid var(--lineA);padding-bottom:6px">FOLLOW ON INSTAGRAM →</a>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(min(30%,190px),1fr));gap:clamp(4px,1.2vw,16px)">
        <a href="https://www.instagram.com/oneofone.unite" target="_blank" rel="noopener" data-reveal="1" style="position:relative;display:block;aspect-ratio:1;overflow:hidden;background:var(--bg2);clip-path:inset(100% 0 0 0);transition:clip-path 1.2s cubic-bezier(0.77,0,0.18,1)">
          <img src="/images/1593032465175-481ac7f401a0-600x600-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.18);transition:transform 1.6s cubic-bezier(0.2,0.7,0.2,1)" />
        </a>
        <a href="https://www.instagram.com/oneofone.unite" target="_blank" rel="noopener" data-reveal="1" style="position:relative;display:block;aspect-ratio:1;overflow:hidden;background:var(--bg2);clip-path:inset(100% 0 0 0);transition:clip-path 1.2s cubic-bezier(0.77,0,0.18,1) 0.08s">
          <img src="/images/1618886614638-80e3c103d31a-600x600-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.18);transition:transform 1.6s cubic-bezier(0.2,0.7,0.2,1) 0.08s" />
        </a>
        <a href="https://www.instagram.com/oneofone.unite" target="_blank" rel="noopener" data-reveal="1" style="position:relative;display:block;aspect-ratio:1;overflow:hidden;background:var(--bg2);clip-path:inset(100% 0 0 0);transition:clip-path 1.2s cubic-bezier(0.77,0,0.18,1) 0.16s">
          <img src="/images/1600091166971-7f9faad6c1e2-600x600-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.18);transition:transform 1.6s cubic-bezier(0.2,0.7,0.2,1) 0.16s" />
        </a>
        <a href="https://www.instagram.com/oneofone.unite" target="_blank" rel="noopener" data-reveal="1" style="position:relative;display:block;aspect-ratio:1;overflow:hidden;background:var(--bg2);clip-path:inset(100% 0 0 0);transition:clip-path 1.2s cubic-bezier(0.77,0,0.18,1) 0.24s">
          <img src="/images/1594938328870-9623159c8c99-600x600-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.18);transition:transform 1.6s cubic-bezier(0.2,0.7,0.2,1) 0.24s" />
        </a>
        <a href="https://www.instagram.com/oneofone.unite" target="_blank" rel="noopener" data-reveal="1" style="position:relative;display:block;aspect-ratio:1;overflow:hidden;background:var(--bg2);clip-path:inset(100% 0 0 0);transition:clip-path 1.2s cubic-bezier(0.77,0,0.18,1) 0.32s">
          <img src="/images/1631052066165-9720608b36da-600x600-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.18);transition:transform 1.6s cubic-bezier(0.2,0.7,0.2,1) 0.32s" />
        </a>
        <a href="https://www.instagram.com/oneofone.unite" target="_blank" rel="noopener" data-reveal="1" style="position:relative;display:block;aspect-ratio:1;overflow:hidden;background:var(--bg2);clip-path:inset(100% 0 0 0);transition:clip-path 1.2s cubic-bezier(0.77,0,0.18,1) 0.4s">
          <img src="/images/1679101893304-045625840a94-600x600-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.18);transition:transform 1.6s cubic-bezier(0.2,0.7,0.2,1) 0.4s" />
        </a>
      </div>
    </div>
  </section>

  <Footer />
</div>
</Base>
<style is:global>
.hv-press-1:hover{background:rgba(249,239,230,0.15) !important}
.hv-press-2:hover{transform:scale(1.04) !important}
</style>

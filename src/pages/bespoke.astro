---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const STEPS = [
  { num: "01", en: "Consultation", meta: "諮詢 · 60 MIN", body: "聊場合、聊習慣、聊你想被看見的樣子。" },
  { num: "02", en: "Cloth", meta: "選料 · 900+ BUNCHES", body: "從英義織廠布本中挑一匹，只為你裁。" },
  { num: "03", en: "Measure", meta: "量身 · 28 POINTS", body: "二十八個數據，加上姿態與慣性的修正。" },
  { num: "04", en: "Fitting", meta: "試衣 · 2 – 3 ROUNDS", body: "毛胚試衣、修正、再修正，直到沒有妥協。" },
  { num: "05", en: "The Record", meta: "交件 · 6 – 8 WEEKS", body: "成衣附上編號與紙型，永久留檔。" }
];
const steps = STEPS.map((s, i) => ({ ...s, open: i === 0, sign: i === 0 ? "−" : "+" }));
---
<Base title="Bespoke — ONE OF ONE 獨壹">
<div style="background:var(--bg);color:var(--ink);font-family:'Helvetica Neue',Helvetica,Arial,sans-serif;overflow-x:clip">
  <Header current="bespoke" />

  <section data-screen-label="01 Title" style="padding:calc(64px + clamp(56px,9vw,140px)) clamp(16px,3vw,40px) clamp(40px,6vw,90px)">
    <div style="max-width:1320px;margin:0 auto">
      <div style="display:flex;align-items:baseline;gap:16px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;color:var(--mute);padding-bottom:clamp(24px,4vw,48px)">
        <span style="color:var(--accent)">03</span>
        <span>BESPOKE — 訂製流程</span>
        <span style="flex:1;height:1px;background:var(--line)"></span>
      </div>
      <div style="display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:28px">
        <h1 data-rise="1" style="margin:0;font-family:'Bodoni Moda',serif;font-weight:400;font-size:clamp(60px,12vw,190px);line-height:0.88;letter-spacing:-0.015em;opacity:0;transform:translateY(40px);transition:opacity 1.1s ease,transform 1.3s cubic-bezier(0.2,0.7,0.2,1)">Bespoke</h1>
        <p data-rise="1" style="margin:0;max-width:40ch;font-size:clamp(15px,1.15vw,17px);line-height:1.75;color:var(--mute);text-wrap:pretty;opacity:0;transform:translateY(24px);transition:opacity 1s ease 0.2s,transform 1.2s cubic-bezier(0.2,0.7,0.2,1) 0.2s">五次會面，一件衣服。從第一次對話到交件，約六至八週。<br />Five appointments, one garment.</p>
      </div>
    </div>
  </section>

  <section data-screen-label="02 Process" style="padding:0 clamp(16px,3vw,40px) clamp(70px,10vw,160px)">
    <div style="max-width:1320px;margin:0 auto">
      <div class="ofo-d">
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,200px),1fr));gap:1px;background:var(--line);border:1px solid var(--line)">
        <div data-rise="1" style="background:var(--bg);padding:clamp(20px,2.4vw,32px) clamp(18px,2vw,28px);min-height:250px;display:flex;flex-direction:column;justify-content:space-between;gap:26px;opacity:0;transform:translateY(24px);transition:opacity 0.9s ease,transform 1.1s cubic-bezier(0.2,0.7,0.2,1)">
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;color:var(--accent)">01</span>
          <div>
            <div style="font-family:'Bodoni Moda',serif;font-size:clamp(22px,1.8vw,28px);padding-bottom:10px">Consultation</div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute);padding-bottom:12px">諮詢 · 60 MIN</div>
            <p style="margin:0;font-size:14px;line-height:1.7;color:var(--mute);text-wrap:pretty">聊場合、聊習慣、聊你想被看見的樣子。</p>
          </div>
        </div>
        <div data-rise="1" style="background:var(--bg);padding:clamp(20px,2.4vw,32px) clamp(18px,2vw,28px);min-height:250px;display:flex;flex-direction:column;justify-content:space-between;gap:26px;opacity:0;transform:translateY(24px);transition:opacity 0.9s ease 0.1s,transform 1.1s cubic-bezier(0.2,0.7,0.2,1) 0.1s">
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;color:var(--accent)">02</span>
          <div>
            <div style="font-family:'Bodoni Moda',serif;font-size:clamp(22px,1.8vw,28px);padding-bottom:10px">Cloth</div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute);padding-bottom:12px">選料 · 900+ BUNCHES</div>
            <p style="margin:0;font-size:14px;line-height:1.7;color:var(--mute);text-wrap:pretty">從英義織廠布本中挑一匹，只為你裁。</p>
          </div>
        </div>
        <div data-rise="1" style="background:var(--bg);padding:clamp(20px,2.4vw,32px) clamp(18px,2vw,28px);min-height:250px;display:flex;flex-direction:column;justify-content:space-between;gap:26px;opacity:0;transform:translateY(24px);transition:opacity 0.9s ease 0.2s,transform 1.1s cubic-bezier(0.2,0.7,0.2,1) 0.2s">
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;color:var(--accent)">03</span>
          <div>
            <div style="font-family:'Bodoni Moda',serif;font-size:clamp(22px,1.8vw,28px);padding-bottom:10px">Measure</div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute);padding-bottom:12px">量身 · 28 POINTS</div>
            <p style="margin:0;font-size:14px;line-height:1.7;color:var(--mute);text-wrap:pretty">二十八個數據，加上姿態與慣性的修正。</p>
          </div>
        </div>
        <div data-rise="1" style="background:var(--bg);padding:clamp(20px,2.4vw,32px) clamp(18px,2vw,28px);min-height:250px;display:flex;flex-direction:column;justify-content:space-between;gap:26px;opacity:0;transform:translateY(24px);transition:opacity 0.9s ease 0.3s,transform 1.1s cubic-bezier(0.2,0.7,0.2,1) 0.3s">
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;color:var(--accent)">04</span>
          <div>
            <div style="font-family:'Bodoni Moda',serif;font-size:clamp(22px,1.8vw,28px);padding-bottom:10px">Fitting</div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute);padding-bottom:12px">試衣 · 2 – 3 ROUNDS</div>
            <p style="margin:0;font-size:14px;line-height:1.7;color:var(--mute);text-wrap:pretty">毛胚試衣、修正、再修正，直到沒有妥協。</p>
          </div>
        </div>
        <div data-rise="1" style="background:var(--bg);padding:clamp(20px,2.4vw,32px) clamp(18px,2vw,28px);min-height:250px;display:flex;flex-direction:column;justify-content:space-between;gap:26px;opacity:0;transform:translateY(24px);transition:opacity 0.9s ease 0.4s,transform 1.1s cubic-bezier(0.2,0.7,0.2,1) 0.4s">
          <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.14em;color:var(--accent)">05</span>
          <div>
            <div style="font-family:'Bodoni Moda',serif;font-size:clamp(22px,1.8vw,28px);padding-bottom:10px">The Record</div>
            <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute);padding-bottom:12px">交件 · 6 – 8 WEEKS</div>
            <p style="margin:0;font-size:14px;line-height:1.7;color:var(--mute);text-wrap:pretty">成衣附上編號與紙型，永久留檔。</p>
          </div>
        </div>
      </div>
</div>
      <div class="ofo-m">
      <div style="display:grid;border-top:1px solid var(--line)">
        {steps.map((st) => (<Fragment>
          <div style="border-bottom:1px solid var(--line)">
            <button type="button" data-step-toggle style="width:100%;display:grid;grid-template-columns:40px minmax(0,1fr) 24px;gap:12px;align-items:center;min-height:76px;padding:12px 0;background:none;border:0;text-align:left;cursor:pointer;color:var(--ink)">
              <span style="width:36px;height:36px;border:1px solid var(--line);border-radius:50%;display:flex;align-items:center;justify-content:center;font-family:'IBM Plex Mono',monospace;font-size:11px;color:var(--accent)">{st.num}</span>
              <span style="display:grid;gap:4px">
                <span style="font-family:'Bodoni Moda',serif;font-size:24px;line-height:1.1">{st.en}</span>
                <span style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--mute)">{st.meta}</span>
              </span>
              <span style="font-size:20px;color:var(--mute);text-align:center" data-step-sign>{st.sign}</span>
            </button>
            <div data-step-body hidden={!st.open}>
              <p style="margin:0;padding:0 0 22px 52px;font-size:15px;line-height:1.75;color:var(--mute);animation:ofoFade 0.3s ease both">{st.body}</p>
            </div>
          </div>
        </Fragment>))}
      </div>
</div>
    </div>
  </section>

  <section data-screen-label="03 Image band" style="position:relative;height:clamp(380px,56vw,760px);overflow:hidden;background:#242321">
    <div data-reveal="1" style="position:absolute;inset:0;overflow:hidden;clip-path:inset(100% 0 0 0);transition:clip-path 1.6s cubic-bezier(0.77,0,0.18,1)">
      <div data-parallax="-0.14" style="position:absolute;top:-14%;bottom:-14%;left:0;right:0">
        <img src="/images/1718184021018-d2158af6b321-2200x1300-bw.jpg" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover;transform:scale(1.15);transition:transform 2.4s cubic-bezier(0.2,0.7,0.2,1)" />
      </div>
    </div>
  </section>

  <section data-screen-label="04 Services" style="background:var(--bgA);color:var(--inkA);padding:clamp(70px,10vw,160px) clamp(16px,3vw,40px)">
    <div style="max-width:1320px;margin:0 auto">
      <div style="display:flex;align-items:baseline;gap:16px;font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;color:var(--muteA);padding-bottom:clamp(28px,4vw,56px)">
        <span style="color:var(--accentA)">SERVICES</span>
        <span>服務項目</span>
        <span style="flex:1;height:1px;background:var(--lineA)"></span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:clamp(28px,4vw,64px)">
        <div data-rise="1" style="border-top:1px solid var(--lineA);padding-top:24px;display:grid;gap:14px;opacity:0;transform:translateY(24px);transition:opacity 1s ease,transform 1.2s cubic-bezier(0.2,0.7,0.2,1)">
          <div style="font-family:'Bodoni Moda',serif;font-size:clamp(30px,3vw,46px);line-height:1">Bespoke</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--muteA)">全客訂 · 手工毛襯 · 專屬紙型</div>
          <p style="margin:0;font-size:15px;line-height:1.75;color:var(--muteA);max-width:44ch;text-wrap:pretty">從零繪製個人紙型，兩至三次試衣。適合想要完全屬於自己版型的人。</p>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--accentA);padding-top:6px">BY CONSULTATION · 6 – 8 WEEKS</div>
        </div>
        <div data-rise="1" style="border-top:1px solid var(--lineA);padding-top:24px;display:grid;gap:14px;opacity:0;transform:translateY(24px);transition:opacity 1s ease 0.15s,transform 1.2s cubic-bezier(0.2,0.7,0.2,1) 0.15s">
          <div style="font-family:'Bodoni Moda',serif;font-size:clamp(30px,3vw,46px);line-height:1">Made-to-Measure</div>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--muteA)">基礎版型修改 · 一次試衣</div>
          <p style="margin:0;font-size:15px;line-height:1.75;color:var(--muteA);max-width:44ch;text-wrap:pretty">以工作室的基礎版型依身形修改，保留 ONE OF ONE 的線條，交期更短。</p>
          <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.18em;color:var(--accentA);padding-top:6px">FROM NT$20,990 · 4 WEEKS</div>
        </div>
      </div>
    </div>
  </section>

  <section id="appointment" data-screen-label="05 Book CTA" style="background:var(--bg2);padding:clamp(70px,10vw,160px) clamp(16px,3vw,40px)">
    <div style="max-width:1320px;margin:0 auto;display:flex;flex-wrap:wrap;align-items:flex-end;justify-content:space-between;gap:32px">
      <div>
        <div style="font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;color:var(--accent);padding-bottom:20px">APPOINTMENT — 預約試訂</div>
        <h2 style="margin:0;font-family:'Bodoni Moda',serif;font-weight:400;font-size:clamp(34px,5vw,76px);line-height:1;text-wrap:balance">Come in.<br />Be measured.</h2>
      </div>
      <a class="hv-bsp-1" href="/book/" style="height:56px;display:flex;align-items:center;gap:14px;padding:0 30px;background:var(--ink);color:var(--bg);font-family:'IBM Plex Mono',monospace;font-size:11px;letter-spacing:0.22em;transition:background 0.25s ease">BOOK THE ATELIER 預約 →</a>
    </div>
  </section>

  <Footer />
</div>
</Base>
<style is:global>
.hv-bsp-1:hover{background:var(--accent) !important;color:var(--bg) !important}
</style>
<script>
const toggles = [...document.querySelectorAll("[data-step-toggle]")];
toggles.forEach((btn, i) => btn.addEventListener("click", () => {
  toggles.forEach((b, j) => {
    const body = b.parentElement.querySelector("[data-step-body]");
    const sign = b.querySelector("[data-step-sign]");
    const open = j === i ? body.hidden : false;
    body.hidden = !open;
    if (sign) sign.textContent = open ? "−" : "+";
  });
}));
</script>

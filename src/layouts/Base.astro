---
const { title = 'ONE OF ONE 獨壹' } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content="ONE OF ONE 獨壹 — 台北不分性別訂製西服。Bespoke &amp; made-to-measure unisex tailoring in Taipei. By appointment only." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;1,6..96,400&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet" />
<script is:inline src="/site.js"></script>
</head>
<body>
<slot />
</body>
</html>
<style is:global>
*{box-sizing:border-box}
html{--bg:#F9EFE6;--bg2:#ECE2D9;--ink:#242321;--mute:#5E5955;--line:rgba(162,153,146,0.5);--accent:#736B65;--bgA:#242321;--inkA:#F9EFE6;--muteA:#A29992;--lineA:rgba(162,153,146,0.32);--accentA:#A29992;--hdr:#A29992;--ftBg:#242321;--ftInk:#F9EFE6;--ftMute:#A29992;--ftLine:rgba(162,153,146,0.32);--ftAccent:#A29992}
html[data-theme="navy"]{--bg:#f1ece2;--bg2:#e7dfd1;--ink:#1c2541;--mute:#565d75;--line:rgba(28,37,65,0.16);--accent:#85693f;--bgA:#1c2541;--inkA:#f1ece2;--muteA:#b3b8c8;--lineA:rgba(241,236,226,0.18);--accentA:#cdb088;--hdr:rgba(241,236,226,0.9);--ftBg:#1c2541;--ftInk:#f1ece2;--ftMute:#b3b8c8;--ftLine:rgba(241,236,226,0.18);--ftAccent:#cdb088}
html[data-theme="noir"]{--bg:#12100e;--bg2:#1c1916;--ink:#f4f1ea;--mute:#a9a193;--line:rgba(244,241,234,0.14);--accent:#a88c63;--bgA:#f4f1ea;--inkA:#12100e;--muteA:#4f4942;--lineA:rgba(18,16,14,0.15);--accentA:#7a6445;--hdr:rgba(18,16,14,0.86);--ftBg:#0b0a09;--ftInk:#f4f1ea;--ftMute:#a9a193;--ftLine:rgba(244,241,234,0.14);--ftAccent:#a88c63}
html,body{margin:0;padding:0;background:var(--bg);color:var(--ink)}
body{-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
a{color:inherit;text-decoration:none}
a:hover{color:var(--accent)}
input,button,textarea,select{font:inherit;color:inherit}
::selection{background:var(--accent);color:#F9EFE6}
@keyframes ofoFade{from{opacity:0}to{opacity:1}}
@keyframes ofoSheet{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:none}}
@keyframes ofoMarquee{from{transform:translateX(0)}to{transform:translateX(-50%)}}
@keyframes ofoCapt{0%{opacity:0;transform:translateY(10px)}100%{opacity:1;transform:none}}
@keyframes ofoIntroOut{0%{opacity:1;transform:translateY(0)}100%{opacity:0;transform:translateY(-26px)}}
@keyframes ofoArcWipe{0%{clip-path:inset(0 50% 48% 50%)}100%{clip-path:inset(0 0 48% 0)}}
@keyframes ofoSweep{0%{-webkit-mask-position:100% 0;mask-position:100% 0}100%{-webkit-mask-position:0 0;mask-position:0 0}}
@keyframes ofoCurtain{0%{transform:translateY(0)}100%{transform:translateY(-101%)}}
html{scroll-behavior:smooth;scroll-padding-top:64px}
button{font:inherit;color:inherit}
.ofo-d{display:contents}
.ofo-m{display:none}
:root{--ar-wide:16/8;--ar-film:16/8}
@media (max-width:760px){.ofo-d{display:none}.ofo-m{display:contents}:root{--ar-wide:4/5;--ar-film:4/5}}
</style>
